# Copy this file to .env and fill in your own values. Never commit .env.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hofars_db
DB_USER=root
DB_PASS=
APP_TIMEZONE=Asia/Kuala_Lumpur
APP_DEBUG=false

# --- Chatbot (optional) ---
# Leave ANTHROPIC_API_KEY empty to use the built-in help only. Never commit a real key.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
# Caps so a public demo cannot run up a bill
CHAT_HOURLY_LIMIT=30
CHAT_DAILY_LIMIT=300
